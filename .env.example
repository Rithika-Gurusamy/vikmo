# DealerDesk Environment Configuration Example
# Copy this file to .env and configure values for your environment.

# Django Core
SECRET_KEY=change-to-a-secure-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database Configuration
# SQLite is strictly prohibited; DealerDesk requires PostgreSQL.
DB_NAME=dealerdesk
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432
